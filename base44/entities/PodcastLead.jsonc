{
  "name": "PodcastLead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "email": {
      "type": "string",
      "maxLength": 150
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "scheduled",
        "completed",
        "not_relevant"
      ],
      "default": "new"
    },
    "rsvp_status": {
      "type": "string",
      "enum": [
        "attending",
        "not_attending"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "description": "\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d2\u05e2\u05d4"
    },
    "rsvp_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05e2\u05d3\u05db\u05d5\u05df \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d4\u05d2\u05e2\u05d4"
    },
    "rsvp_source": {
      "type": "string",
      "enum": [
        "representative",
        "link"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "description": "\u05de\u05d9 \u05e2\u05d3\u05db\u05df: \u05e0\u05e6\u05d9\u05d2 \u05d0\u05d5 \u05d4\u05e0\u05e8\u05e9\u05dd/\u05ea \u05d3\u05e8\u05da \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8"
    },
    "rsvp_by": {
      "type": "string",
      "maxLength": 150,
      "description": "\u05e9\u05dd \u05d4\u05de\u05e2\u05d3\u05db\u05df/\u05ea"
    },
    "rsvp_token": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05e4\u05e0\u05d9\u05de\u05d9 \u05dc\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d4\u05d2\u05e2\u05d4"
    },
    "rsvp_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05e9\u05dc\u05d9\u05d7\u05ea \u05d1\u05e7\u05e9\u05ea \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d2\u05e2\u05d4 \u05d1\u05de\u05d9\u05d9\u05dc"
    },
    "rsvp_request_status": {
      "type": "string",
      "enum": [
        "sent",
        "failed"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "description": "\u05ea\u05d5\u05e6\u05d0\u05ea \u05e9\u05dc\u05d9\u05d7\u05ea \u05d1\u05e7\u05e9\u05ea \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d4\u05d2\u05e2\u05d4"
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "create": {
      "data.status": "new"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "sales_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "collections_manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "sales_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "collections_manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}