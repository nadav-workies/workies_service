{
  "name": "PodcastLead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "email": {
      "type": "string",
      "maxLength": 150
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "scheduled",
        "completed",
        "not_relevant"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "phone",
    "email"
  ],
  "rls": {
    "create": {
      "data.status": "new"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "sales_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "collections_manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "sales_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "collections_manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}