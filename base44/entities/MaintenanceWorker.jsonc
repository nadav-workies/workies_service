{
  "name": "MaintenanceWorker",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d0\u05d9\u05e9 \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e2\u05d5\u05d1\u05d3 \u05e4\u05e2\u05d9\u05dc \u05dc\u05e9\u05d9\u05d1\u05d5\u05e5"
    },
    "work_schedule": {
      "type": "array",
      "description": "\u05d9\u05d5\u05de\u05df \u05e2\u05d1\u05d5\u05d3\u05d4 \u05e9\u05d1\u05d5\u05e2\u05d9 \u2014 \u05d9\u05de\u05d9\u05dd \u05d5\u05e9\u05e2\u05d5\u05ea \u05e2\u05d1\u05d5\u05d3\u05d4 \u05e7\u05d1\u05d5\u05e2\u05d9\u05dd",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": {
            "type": "number",
            "description": "0=\u05e8\u05d0\u05e9\u05d5\u05df ... 6=\u05e9\u05d1\u05ea"
          },
          "is_working": {
            "type": "boolean",
            "default": false
          },
          "start_time": {
            "type": "string",
            "default": "09:00"
          },
          "end_time": {
            "type": "string",
            "default": "17:00"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "maintenance_manager"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}