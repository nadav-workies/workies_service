{
  "name": "WorkiesAILead",
  "type": "object",
  "properties": {
    "business_name": {
      "maxLength": 150,
      "type": "string"
    },
    "deposit_status": {
      "default": "pending",
      "enum": [
        "pending",
        "secured",
        "charged",
        "released"
      ],
      "type": "string"
    },
    "email": {
      "maxLength": 150,
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "type": "string"
    },
    "phone": {
      "maxLength": 30,
      "type": "string"
    },
    "session": {
      "enum": [
        "01",
        "02",
        "03",
        "04",
        "05",
        "06"
      ],
      "type": "string"
    },
    "session_date": {
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05de\u05e4\u05d2\u05e9 \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 YYYY-MM-DD",
      "type": "string"
    },
    "status": {
      "default": "new",
      "enum": [
        "new",
        "contacted",
        "scheduled",
        "completed",
        "not_relevant"
      ],
      "type": "string"
    },
    "terms_accepted": {
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "phone",
    "business_name",
    "session",
    "terms_accepted"
  ],
  "rls": {
    "create": {
      "data.status": "new"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "sales_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "collections_manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "sales_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "collections_manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}