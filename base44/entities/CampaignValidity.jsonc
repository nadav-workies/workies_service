{
  "name": "CampaignValidity",
  "type": "object",
  "properties": {
    "campaign": {
      "type": "string",
      "enum": [
        "office",
        "podcast",
        "referral",
        "workies_ai",
        "hr_meetup"
      ]
    },
    "end_date": {
      "type": "string",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05db\u05d5\u05dc\u05dc, \u05e8\u05d9\u05e7 \u05dc\u05dc\u05d0 \u05d4\u05d2\u05d1\u05dc\u05ea \u05ea\u05d5\u05e7\u05e3"
    },
    "is_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d3\u05dc\u05e7\u05d4/\u05db\u05d9\u05d1\u05d5\u05d9 \u05d9\u05d3\u05e0\u05d9 \u05e9\u05dc \u05e2\u05de\u05d5\u05d3 \u05d4\u05e0\u05d7\u05d9\u05ea\u05d4"
    },
    "webhook_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u05e9\u05dc\u05d9\u05d7\u05ea \u05dc\u05d9\u05d3\u05d9\u05dd \u05dc\u05d5\u05d5\u05d1 \u05d4\u05d5\u05e7 Make"
    }
  },
  "required": [
    "campaign"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}