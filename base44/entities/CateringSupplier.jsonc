      "default": true,
      "description": "\u05db\u05e9\u05e8",
      "type": "boolean"
    },
    "kashrut_label": {
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05db\u05e9\u05e8\u05d5\u05ea \u05e9\u05de\u05d5\u05e6\u05d2 \u05dc\u05dc\u05e7\u05d5\u05d7, \u05dc\u05de\u05e9\u05dc \u05db\u05e9\u05e8 \u05e8\u05d1\u05e0\u05d5\u05ea \u05d1\u05d0\u05e8 \u05e9\u05d1\u05e2",
