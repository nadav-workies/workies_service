{
  "name": "MailContact",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "maxLength": 150,
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc (\u05de\u05e0\u05d5\u05e8\u05de\u05dc, \u05d0\u05d5\u05ea\u05d9\u05d5\u05ea \u05e7\u05d8\u05e0\u05d5\u05ea)"
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "company": {
      "type": "string",
      "maxLength": 150
    },
    "consent": {
      "type": "string",
      "enum": [
        "subscribed",
        "pending",
        "unsubscribed",
        "bounced",
        "complained"
      ],
      "enumColors": [
        "green",
        "yellow",
        "gray",
        "red",
        "red"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e1\u05db\u05de\u05d4 \u05dc\u05d3\u05d9\u05d5\u05d5\u05e8"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05d4\u05e8\u05e9\u05de\u05d4"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "list_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u05e8\u05e9\u05d9\u05de\u05d5\u05ea \u05e1\u05d8\u05d8\u05d9\u05d5\u05ea \u05e9\u05d0\u05d9\u05e9 \u05d4\u05e7\u05e9\u05e8 \u05e9\u05d9\u05d9\u05da \u05d0\u05dc\u05d9\u05d4\u05df"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "\u05e0\u05d9\u05e7\u05d5\u05d3 \u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea"
    },
    "opens": {
      "type": "number",
      "default": 0
    },
    "clicks": {
      "type": "number",
      "default": 0
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "unsubscribed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}