{
  "name": "CustomerInsight",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05dc\u05e7\u05d5\u05d7 (RoomTenant)"
    },
    "conversation_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e9\u05d9\u05d7\u05d4 \u05e9\u05de\u05de\u05e0\u05d4 \ufffd\u05e0\u05d5\u05e6\u05e8\u05d4 \u05d4\u05ea\u05d5\u05d1\u05e0\u05d4"
    },
    "customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "room_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05de\u05e9\u05e8\u05d3"
    },
    "insight_type": {
      "type": "string",
      "enum": [
        "business_domain",
        "expertise",
        "target_customer",
        "need",
        "opportunity",
        "content_idea",
        "connection_idea",
        "follow_up",
        "birthday",
        "tag"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05ea\u05d5\u05d1\u05e0\u05d4"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05ea\u05d5\u05d1\u05e0\u05d4"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05ea\u05d5\u05d1\u05e0\u05d4"
    },
    "source_quote": {
      "type": "string",
      "description": "\u05e6\u05d9\u05d8\u05d5\u05d8 \u05de\u05e7\u05d5\u05e8 \u05de\u05ea\u05d5\u05da \u05d4\u05e9\u05d9\u05d7\u05d4"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "default": "unknown",
      "description": "\u05e8\u05de\u05ea \u05d1\u05d9\u05d8\u05d7\u05d5\u05df"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "used",
        "dismissed"
      ],
      "default": "new",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05ea\u05d5\u05d1\u05e0\u05d4"
    },
    "source_system": {
      "type": "string",
      "default": "customer_conversation",
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05ea\u05d5\u05d1\u05e0\u05d4"
    }
  },
  "required": [
    "tenant_id",
    "insight_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}