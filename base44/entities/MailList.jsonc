{
  "name": "MailList",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "type": {
      "type": "string",
      "enum": [
        "static",
        "dynamic"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "static",
      "description": "\u05e1\u05d8\u05d8\u05d9\u05ea (\u05d9\u05d3\u05e0\u05d9\u05ea / \u05d9\u05d9\u05d1\u05d5\u05d0) \u05d0\u05d5 \u05e1\u05d2\u05de\u05e0\u05d8 \u05d3\u05d9\u05e0\u05de\u05d9"
    },
    "rule_consent": {
      "type": "string",
      "description": "\u05e1\u05d2\u05de\u05e0\u05d8: \u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e1\u05db\u05de\u05d4"
    },
    "rule_source": {
      "type": "string",
      "description": "\u05e1\u05d2\u05de\u05e0\u05d8: \u05de\u05e7\u05d5\u05e8"
    },
    "rule_tag": {
      "type": "string",
      "maxLength": 40,
      "description": "\u05e1\u05d2\u05de\u05e0\u05d8: \u05ea\u05d2\u05d9\u05ea"
    },
    "description": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}