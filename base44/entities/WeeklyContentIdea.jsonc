{
  "name": "WeeklyContentIdea",
  "type": "object",
  "properties": {
    "week_start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05e9\u05d1\u05d5\u05e2"
    },
    "planned_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e4\u05e8\u05e1\u05d5\u05dd \u05de\u05ea\u05d5\u05db\u05e0\u05df"
    },
    "day_of_week": {
      "type": "string",
      "enum": [
        "sunday",
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday"
      ],
      "description": "\u05d9\u05d5\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2"
    },
    "platform": {
      "type": "string",
      "enum": [
        "facebook",
        "instagram",
        "linkedin",
        "story",
        "whatsapp_community",
        "newsletter"
      ],
      "description": "\u05e4\u05dc\u05d8\u05e4\u05d5\u05e8\u05de\u05ea \u05ea\u05d5\u05db\u05df"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d9\u05d7\u05d9\u05d3\u05ea \u05d4\u05ea\u05d5\u05db\u05df"
    },
    "topic": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 / \u05e8\u05e2\u05d9\u05d5\u05df \u05ea\u05d5\u05db\u05df"
    },
    "output_type": {
      "type": "string",
      "enum": [
        "post",
        "community_event",
        "story",
        "reels",
        "podcast"
      ],
      "description": "\u05ea\u05d5\u05e6\u05e8: \u05e4\u05d5\u05e1\u05d8 / \u05d0\u05d9\u05e8\u05d5\u05e2 \u05e7\u05d4\u05d9\u05dc\u05d4 / \u05e1\u05d8\u05d5\u05e8\u05d9 / \u05e8\u05d9\u05dc\u05e1 / \u05e4\u05d5\u05d3\u05e7\u05d0\u05e1\u05d8"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "customer_interview",
        "event_story_photos",
        "survey",
        "conversation_transcript",
        "meeting"
      ],
      "description": "\u05d0\u05de\u05e6\u05e2\u05d9 / \u05de\u05e7\u05d5\u05e8 \u05d4\u05ea\u05d5\u05db\u05df"
    },
    "source_text": {
      "type": "string",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05de\u05e7\u05d5\u05e8 / \u05ea\u05de\u05dc\u05d5\u05dc / \u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "attachments": {
      "type": "array",
      "description": "\u05e7\u05d1\u05e6\u05d9\u05dd \u05de\u05e6\u05d5\u05e8\u05e4\u05d9\u05dd (\u05ea\u05de\u05d5\u05e0\u05d4 / \u05d5\u05d9\u05d3\u05d0\u05d5) \u2014 \u05e0\u05de\u05d7\u05e7\u05d9\u05dd \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea 30 \u05d9\u05d5\u05dd \u05d0\u05d7\u05e8\u05d9 \u05de\u05d5\u05e2\u05d3 \u05d4\u05ea\u05d5\u05db\u05df",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string"
          }
        }
      }
    },
    "content_type": {
      "type": "string",
      "enum": [
        "customer_specific",
        "workies_general"
      ],
      "default": "customer_specific",
      "description": "\u05e1\u05d5\u05d2 \u05ea\u05d5\u05db\u05df: \u05de\u05d5\u05ea\u05d0\u05dd \u05dc\u05dc\u05e7\u05d5\u05d7 \u05d0\u05d5 \u05db\u05dc\u05dc\u05d9 \u05dc\u05d5\u05d5\u05e8\u05e7\u05d9\u05d6"
    },
    "content_format": {
      "type": "string",
      "enum": [
        "post",
        "reels",
        "story",
        "carousel",
        "newsletter",
        "whatsapp",
        "linkedin",
        "other"
      ],
      "description": "\u05e9\u05d3\u05d4 \u05d9\u05e9\u05df \u2014 \u05d4\u05d5\u05d7\u05dc\u05e3 \u05d1-output_type"
    },
    "related_customer_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05dc\u05e7\u05d5\u05d7 \u05e7\u05e9\u05d5\u05e8"
    },
    "related_customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05dc\u05e7\u05d5\u05d7 \u05e7\u05e9\u05d5\u05e8"
    },
    "source_insight_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05ea\u05d5\u05d1\u05e0\u05d4 \u05de\u05e7\u05d5\u05e8"
    },
    "source_conversation_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05d9\u05d7\u05ea \u05de\u05e7\u05d5\u05e8"
    },
    "source_note": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05ea \u05de\u05e7\u05d5\u05e8 / \u05e6\u05d9\u05d8\u05d5\u05d8"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "ai_recommendations": {
      "type": "object",
      "description": "\u05d4\u05de\u05dc\u05e6\u05d5\u05ea AI \u05de\u05d5\u05d1\u05e0\u05d5\u05ea \u05dc\u05d9\u05d7\u05d9\u05d3\u05ea \u05d4\u05ea\u05d5\u05db\u05df",
      "properties": {
        "recommended_angles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_hook": {
          "type": "string"
        },
        "recommended_structure": {
          "type": "string"
        },
        "key_messages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "what_not_to_say": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "post_draft": {
      "type": "string",
      "description": "\u05d8\u05d9\u05d5\u05d8\u05ea \u05e4\u05d5\u05e1\u05d8"
    },
    "image_prompt": {
      "type": "string",
      "description": "\u05e4\u05e8\u05d5\u05de\u05e4\u05d8 \u05dc\u05ea\u05de\u05d5\u05e0\u05d4 / \u05d5\u05d9\u05d6\u05f3\u05d5\u05d0\u05dc"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05d2\u05d9\u05d5\u05ea / \u05d4\u05d0\u05e9\u05d8\u05d2\u05d9\u05dd"
    },
    "final_content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05e6\u05e8 \u05e1\u05d5\u05e4\u05d9 \u05de\u05d0\u05d5\u05e9\u05e8"
    },
    "final_approved": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05d5\u05e6\u05e8 \u05d0\u05d5\u05e9\u05e8 \u05e1\u05d5\u05e4\u05d9\u05ea"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d0\u05d9\u05e9\u05d5\u05e8"
    },
    "approved_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05d0\u05d9\u05e9\u05e8"
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "not_checked",
        "done",
        "not_done"
      ],
      "default": "not_checked",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d1\u05d9\u05e6\u05d5\u05e2: \u05d1\u05d5\u05e6\u05e2 / \u05dc\u05d0 \u05d1\u05d5\u05e6\u05e2"
    },
    "execution_note": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05ea \u05d0\u05d9 \u05d1\u05d9\u05e6\u05d5\u05e2"
    },
    "ai_thread_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      },
      "description": "\u05d4\u05ea\u05db\u05ea\u05d1\u05d5\u05ea AI \u05e2\u05dc \u05d9\u05d7\u05d9\u05d3\u05ea \u05d4\u05ea\u05d5\u05db\u05df"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "planned",
        "in_progress",
        "draft_ready",
        "needs_approval",
        "approved",
        "published",
        "not_done",
        "cancelled",
        "to_plan",
        "to_write",
        "needs_visual",
        "ready_for_approval",
        "dismissed"
      ],
      "default": "idea",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e2\u05d1\u05d5\u05d3\u05d4 \u05e9\u05dc \u05d9\u05d7\u05d9\u05d3\u05ea \u05d4\u05ea\u05d5\u05db\u05df"
    }
  },
  "required": [
    "topic"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}