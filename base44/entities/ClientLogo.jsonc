{
  "name": "ClientLogo",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 150,
      "description": "\u05e9\u05dd \u05d4\u05d0\u05e8\u05d2\u05d5\u05df (\u05de\u05e9\u05de\u05e9 \u05db\u05d8\u05e7\u05e1\u05d8 \u05d7\u05dc\u05d5\u05e4\u05d9)"
    },
    "logo_image": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05e7\u05d5\u05d1\u05e5 \u05d4\u05dc\u05d5\u05d2\u05d5 (PNG / SVG / WebP)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05ea\u05e6\u05d5\u05d2\u05d4"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05de\u05d5\u05e6\u05d2 \u05d1\u05e2\u05de\u05d5\u05d3"
    },
    "show_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "workies-events"
      ],
      "description": "\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05e9\u05d4\u05dc\u05d5\u05d2\u05d5 \u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05d4\u05dd"
    }
  },
  "required": [
    "name",
    "logo_image"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}