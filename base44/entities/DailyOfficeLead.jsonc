{
  "name": "DailyOfficeLead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "email": {
      "type": "string",
      "maxLength": 150
    },
    "team_size": {
      "type": "string",
      "enum": [
        "1",
        "2-3",
        "4+"
      ],
      "description": "\u05db\u05de\u05d4 \u05d0\u05e0\u05e9\u05d9\u05dd \u05d9\u05e2\u05d1\u05d3\u05d5 \u05d1\u05de\u05e9\u05e8\u05d3"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "scheduled",
        "completed",
        "not_relevant"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "create": {
      "data.status": "new"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "sales_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "collections_manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "sales_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "collections_manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}