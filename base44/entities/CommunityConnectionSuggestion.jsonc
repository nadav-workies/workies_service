{
  "name": "CommunityConnectionSuggestion",
  "type": "object",
  "properties": {
    "customer_a_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05dc\u05e7\u05d5\u05d7 \u05d0\u05f3"
    },
    "customer_a_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05dc\u05e7\u05d5\u05d7 \u05d0\u05f3"
    },
    "customer_b_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05dc\u05e7\u05d5\u05d7 \u05d1\u05f3 (\u05d0\u05dd \u05d9\u05d3\u05d5\u05e2)"
    },
    "customer_b_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05dc\u05e7\u05d5\u05d7 \u05d1\u05f3 \u05d0\u05d5 \u05ea\u05d9\u05d0\u05d5\u05e8 \u05e1\u05d5\u05d2 \u05dc\u05e7\u05d5\u05d7 \u05de\u05ea\u05d0\u05d9\u05dd"
    },
    "reason": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05ea \u05d4\u05d7\u05d9\u05d1\u05d5\u05e8 \u05d4\u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc\u05d9"
    },
    "source_conversation_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e9\u05d9\u05d7\u05d4 \u05e9\u05de\u05de\u05e0\u05d4 \u05e0\u05d5\u05e6\u05e8 \u05d4\u05e8\u05e2\u05d9\u05d5\u05df"
    },
    "source_quote": {
      "type": "string",
      "description": "\u05e6\u05d9\u05d8\u05d5\u05d8 \u05de\u05e7\u05d5\u05e8"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium",
      "description": "\u05e8\u05de\u05ea \u05d1\u05d9\u05d8\u05d7\u05d5\u05df"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "to_review",
        "approved",
        "done",
        "not_relevant"
      ],
      "default": "idea",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d7\u05d9\u05d1\u05d5\u05e8"
    }
  },
  "required": [
    "customer_a_id",
    "customer_a_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}