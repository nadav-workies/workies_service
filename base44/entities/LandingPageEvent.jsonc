{
  "name": "LandingPageEvent",
  "type": "object",
  "properties": {
    "landing_page_id": {
      "type": "string",
      "maxLength": 50,
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e2\u05de\u05d5\u05d3 \u05d4\u05e0\u05d7\u05d9\u05ea\u05d4"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "view",
        "whatsapp_click",
        "phone_click",
        "waze_click"
      ],
      "enumColors": [
        "gray",
        "green",
        "blue",
        "purple"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "button_location": {
      "type": "string",
      "maxLength": 40,
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05db\u05e4\u05ea\u05d5\u05e8: hero / footer_cta / sticky_bar"
    },
    "utm_source": {
      "type": "string",
      "maxLength": 150
    },
    "utm_medium": {
      "type": "string",
      "maxLength": 150
    },
    "utm_campaign": {
      "type": "string",
      "maxLength": 150
    },
    "referrer": {
      "type": "string",
      "maxLength": 500
    },
    "device": {
      "type": "string",
      "enum": [
        "mobile",
        "desktop"
      ],
      "enumColors": [
        "blue",
        "gray"
      ]
    }
  },
  "required": [
    "landing_page_id",
    "event_type"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "sales_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "data.internal_role": "collections_manager"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}